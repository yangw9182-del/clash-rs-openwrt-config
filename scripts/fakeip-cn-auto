#!/bin/sh
# ============================================================
# fakeip-cn-auto v2 - 国内域名白名单 收集/应用 双模式
# 用法:
#   fakeip-cn-auto sync          收集: clash connections 动态源 + 参数域名
#                                → 写 /etc/clash-rs/fakeip-cn.list（零重启、不改配置）
#   fakeip-cn-auto apply         应用: list → config.yaml fake-ip-filter（零重启；init.d start 时调用）
#   fakeip-cn-auto apply-restart 应用 + 重启 clash-rs（手动完整生效）
#   fakeip-cn-auto 域名...       手动收集指定域名到 list
# 原理: 国内域名进 fake-ip-filter → DNS 返回真实 IP → iptables cn_ip 直连
#       （流量完全不经过 clash-rs 进程 = 最快；IP 层 cn_ip 兜底 = 误判最少）
# ============================================================
CONFIG=/etc/clash-rs/config.yaml
LIST=/etc/clash-rs/fakeip-cn.list
LOCK=/tmp/fakeip-cn-auto.lock
LOG=/var/log/fakeip-cn-auto.log
DNSS="119.29.29.29 223.5.5.5 114.114.114.114"
API=http://127.0.0.1:9090
AUTH="Authorization: Bearer clashrs2026"

# 单实例锁
[ -f "$LOCK" ] && [ -d "/proc/$(cat $LOCK 2>/dev/null)" ] && exit 0
echo $$ > "$LOCK"
trap "rm -f $LOCK" EXIT

is_ip() { echo "$1" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; }

# 判断单个域名是否国内，是则追加到 list（幂等：已在 config/list 跳过）
collect_one() {
    d="$1"
    [ -z "$d" ] && return
    grep -qF "    - '+.$d'" "$CONFIG" 2>/dev/null && return
    grep -Fxq "$d" "$LIST" 2>/dev/null && return
    ip=""
    for ns in $DNSS; do
        ip=$(nslookup "$d" "$ns" 2>/dev/null | grep -E 'Address [0-9]' | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -2 | tr '\n' ' ')
        [ -n "$ip" ] && break
    done
    if [ -z "$ip" ]; then
        echo "$(date): SKIP 解析失败 $d" >> "$LOG"
        return
    fi
    for ip1 in $ip; do
        # ipset test 退出码: 0=in cn_ip(大陆)
        if ipset test cn_ip "$ip1" >/dev/null 2>&1; then
            echo "$d" >> "$LIST"
            sort -u "$LIST" -o "$LIST" 2>/dev/null
            echo "$(date): COLLECT 国内 $d -> $ip" >> "$LOG"
            return
        fi
    done
    echo "$(date): SKIP 非国内 $d -> $ip" >> "$LOG"
}

sync() {
    echo "$(date): === sync 开始 ===" >> "$LOG"
    # 动态源: clash 当前活动连接的域名（自学习用户实际访问的域名）
    curl -s --max-time 6 "$API/connections" -H "$AUTH" 2>/dev/null \
        | grep -oE '"host":"[^"]+"' | sed 's/"host":"//; s/"//' \
        | sort -u | while IFS= read -r d; do
            is_ip "$d" && continue
            echo "$d" | grep -qE '\.(arpa|local|lan|i2p)$' && continue
            collect_one "$d"
        done
    # 命令行追加的域名
    for d in "$@"; do
        collect_one "$d"
    done
    echo "$(date): === sync 完成 ($(wc -l < "$LIST" 2>/dev/null || echo 0) 条 in list) ===" >> "$LOG"
}

apply() {
    [ -s "$LIST" ] || { echo "list 空，无应用"; return 1; }
    added=""
    while IFS= read -r d; do
        [ -z "$d" ] && continue
        grep -qF "    - '+.$d'" "$CONFIG" 2>/dev/null && continue
        added="$added $d"
    done < "$LIST"
    [ -z "$added" ] && { echo "无新增，不需应用(零重启)"; return 0; }
    cp "$CONFIG" "$CONFIG.bak.fakeip.$(date +%s)" 2>/dev/null
    for d in $added; do
        sed -i "s|^    - '+\.cn'|    - '+.$d'\n    - '+.cn'|" "$CONFIG" 2>/dev/null
    done
    echo "$(date): apply 新增 $(echo $added | wc -w) 个: $added" >> "$LOG"
    echo "已应用 $(echo $added | wc -w) 个域名到 fake-ip-filter (零重启)"
    return 0
}

case "$1" in
    sync)          shift; sync "$@" ;;
    apply)         apply ;;
    apply-restart) apply && /etc/init.d/clash-rs restart >/dev/null 2>&1 ;;
    *)
        if [ $# -gt 0 ]; then sync "$@"
        else
            echo "用法: fakeip-cn-auto [sync|apply|apply-restart|域名...]" >&2
            exit 1
        fi
        ;;
esac
exit 0
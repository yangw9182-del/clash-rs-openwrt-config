  nameserver:
    - 119.29.29.29
    - 223.5.5.5

  proxy-server-nameserver:
    - 119.29.29.29
    - 223.5.5.5
  fallback:
    - 114.114.114.114
    - 119.29.29.29
  fallback-timeout: 2
  fallback-filter:
    geoip: true
    ipcidr:
      - 240.0.0.0/4

proxies:
proxies:
  # ============================================
  # 节点配置区：此处填写你自己的节点
  # 支持: anytls / ss / trojan / vmess / vless 等
  #
  # 推荐: 用 `cc node add <订阅链接>` 或
  #       `cc sub-update` 从机场自动拉取节点
  #       （无需手动填写下面的条目）
  #
  # 手动添加单个节点示例:
  # - {name: "HK-1", server: 1.2.3.4, port: 8443, type: anytls,
  #    password: "your-password", client-fingerprint: chrome,
  #    sni: www.baidu.com, skip-cert-verify: true, udp: true}
  # - {name: "SS-1", server: 1.2.3.5, port: 8388, type: ss,
  #    cipher: aes-128-gcm, password: "your-password", udp: true}
  # ============================================

proxy-groups:
  - name: PROXY
    type: select
    proxies:
      - AUTO
      - DIRECT
      - "HK-1"
      - "HK-2"
      - "HK-3"
      - "HK-4"
      - "HK-5"
      - "HK-6"
      - "JP-1"
      - "JP-2"
      - "JP-3"
      - "JP-4"
      - "JP-5"
      - "JP-6"
      - "JP-7"
      - "SG-1"
      - "SG-2"
      - "SG-3"
      - "SG-4"
      - "SG-5"
      - "US-1"
      - "US-2"
      - "US-3"
      - "US-4"

  - name: AUTO
    type: url-test
    url: http://cp.cloudflare.com/generate_204
    interval: 600
    tolerance: 100
    timeout: 5
    proxies:
      - "HK-1"
      - "HK-4"
      - "HK-5"
      - "JP-1"
      - "JP-2"
      - "JP-3"
      - "JP-5"
      - "JP-7"
      - "SG-1"
      - "SG-2"
      - "SG-4"
      - "SG-5"
      - "US-1"
      - "US-2"
      - "US-3"
      - "US-4"

rules:
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
  - IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
  - SRC-IP-CIDR,192.168.10.1/32,DIRECT
  - DST-PORT,53,DIRECT
  - GEOIP,CN,DIRECT
  - MATCH,PROXY

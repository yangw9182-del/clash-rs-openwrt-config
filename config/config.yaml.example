# Generated by aladdin_update.py (SS+Trojan+AnyTLS, auto-detect)
ipv6: false
routing-mark: 1
allow-lan: true
mode: rule
log-level: error
external-controller: 0.0.0.0:9090
external-ui: /etc/clash-rs/ui
external-ui-url: https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip
secret: "CHANGE-ME"
cors-allow-origins:
  - "*"
mixed-port: 7890
redir-port: 7892
tproxy-port: 7893
mmdb: /etc/clash-rs/country.mmdb

profile:
  store-selected: true
  store-fake-ip: false

experimental:
  tcp-buffer-size: 65536
  ignore-resolve-fail: true

dns:
  enable: true
  ipv6: false
  listen:
    udp: 0.0.0.0:1053
    tcp: 0.0.0.0:1053
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  use-hosts: true
  default-nameserver:
    - 119.29.29.29
    - 223.5.5.5
  fake-ip-filter:
    # ===== LAN/本地 =====
    - '*.lan'
    - '*.localdomain'
    - '*.example'
    - '*.invalid'
    - '*.localhost'
    - '*.test'
